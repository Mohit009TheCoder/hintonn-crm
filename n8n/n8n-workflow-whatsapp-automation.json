    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"skipped\": true }",
        "options": {}
      },
      "id": "respond-skip",
      "name": "Respond Skip",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [920, 780]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-verify",
      "name": "WhatsApp Verify",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 960],
      "webhookId": "whatsapp-verify"
    },
    {
      "parameters": {
        "jsCode": "// Meta WhatsApp webhook verification\n// When you set up the webhook in Meta, it sends a GET request with:\n// hub.mode=subscribe\n// hub.challenge=<random string>\n// hub.verify_token=<your verify token>\n\nconst query = $input.first().json.query;\nconst mode = query['hub.mode'];\nconst token = query['hub.verify_token'];\nconst challenge = query['hub.challenge'];\n\nconst VERIFY_TOKEN = $env.WHATSAPP_VERIFY_TOKEN || 'hintonn-crm-verify-token';\n\nif (mode === 'subscribe' && token === VERIFY_TOKEN) {\n  return [{ json: { verified: true, challenge: challenge } }];\n} else {\n  return [{ json: { verified: false, challenge: '' } }];\n}"
      },
      "id": "verify-token",
      "name": "Verify Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 960]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.challenge }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-challenge",
      "name": "Respond Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [700, 960]
    }

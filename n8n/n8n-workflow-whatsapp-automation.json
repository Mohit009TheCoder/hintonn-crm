        "url": "={{ $env.CRM_WEBHOOK_URL || 'http://localhost:5001' }}/api/webhooks/message",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phone\": \"{{ $json.phone }}\",\n  \"message\": {{ JSON.stringify($json.message) }},\n  \"timestamp\": \"{{ $json.timestamp }}\"\n}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "forward-to-crm",
      "name": "Forward to CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 600]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true }",
        "options": {}
      },
      "id": "respond-whatsapp-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",

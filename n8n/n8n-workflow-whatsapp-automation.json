    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.data.phone.replace(/[^0-9]/g, '') }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": {{ JSON.stringify($json.data.message) }}\n  }\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "whatsapp-send",
      "name": "Send WhatsApp Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "whatsapp-token",
          "name": "WhatsApp Cloud API Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract WhatsApp API response and build callback payload\nconst input = $input.first().json;\nconst triggerData = $('CRM Webhook Trigger').first().json;\n\nconst success = input.messages && input.messages.length > 0;\nconst messageId = success ? input.messages[0].id : null;\n\nreturn [{\n  json: {\n    leadId: triggerData.data.leadId,\n    status: success ? 'sent' : 'failed',\n    messageId: messageId,\n    error: success ? null : (input.error?.message || 'Unknown error'),\n    waApiResponse: input\n  }\n}];"
      },
      "id": "build-callback",
      "name": "Build Callback Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_WEBHOOK_URL || 'http://localhost:5001' }}/api/webhooks/inbound",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"leadId\": {{ $json.leadId }},\n  \"status\": \"{{ $json.status }}\",\n  \"messageId\": \"{{ $json.messageId }}\",\n  \"error\": {{ $json.error ? JSON.stringify($json.error) : 'null' }}\n}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "callback-crm",
      "name": "Callback to CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"messageId\": {{ $('Build Callback Payload').first().json.messageId ? JSON.stringify($('Build Callback Payload').first().json.messageId) : 'null' }},\n  \"event\": \"{{ $('CRM Webhook Trigger').first().json.event }}\"\n}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1380, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"pong\",\n  \"timestamp\": \"{{ $now.toISO() }}\"\n}",
        "options": {}
      },
      "id": "respond-ping",
      "name": "Respond Ping",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 440]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-whatsapp-inbound",
      "name": "WhatsApp Inbound Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 660],
      "webhookId": "whatsapp-inbound"
    },
    {
      "parameters": {
        "jsCode": "// Parse incoming WhatsApp webhook from Meta\nconst body = $input.first().json.body;\n\n// Meta sends verification challenges as GET requests\n// For POST, the payload structure is:\n// { entry: [{ changes: [{ value: { messages: [...] } }] }] }\n\nif (!body || !body.entry || !body.entry[0]) {\n  return [{ json: { skip: true, reason: 'No entry' } }];\n}\n\nconst entry = body.entry[0];\nconst changes = entry.changes?.[0];\nconst value = changes?.value;\n\nif (!value?.messages || value.messages.length === 0) {\n  // This is a status update, not an inbound message\n  return [{ json: { skip: true, reason: 'Status update' } }];\n}\n\nconst msg = value.messages[0];\nconst contact = value.contacts?.[0];\n\nreturn [{\n  json: {\n    skip: false,\n    phone: msg.from,\n    message: msg.text?.body || msg.type,\n    messageId: msg.id,\n    timestamp: msg.timestamp,\n    contactName: contact?.profile?.name || 'Unknown',\n    messageType: msg.type\n  }\n}];"
      },
      "id": "parse-whatsapp-inbound",
      "name": "Parse Inbound Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 660]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-skip",
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-skip",
      "name": "Skip Status Updates",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 660]
    },
    {

{
  "name": "hintonn-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Hintonn AI — Lead Automation & Real Estate CRM System",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "server": "npm run start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "emulator": "firebase emulators:start --project demo-hintonn-crm --only firestore",
    "seed": "npm run seed --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

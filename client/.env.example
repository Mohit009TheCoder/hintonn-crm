# Client Environment Variables
# Copy to .env.local for local dev, or set in Vercel dashboard for production

# ── Backend API URL ────────────────────────────────────
# Leave empty for local dev (Vite proxy handles it automatically)
# In Vercel dashboard, set this to your Railway backend URL:
# Example: VITE_API_URL=https://hintonn-crm-api.up.railway.app
VITE_API_URL=

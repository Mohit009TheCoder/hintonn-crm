{
  "version": 2,
  "name": "hintonn-crm",
  "framework": "vite",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "installCommand": "npm install --prefix client && npm install --prefix server",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**"
    },
    "api/cron-automation.js": {
      "includeFiles": "server/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron-automation?secret=hintonn-cron-2026",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
